{
  "name": "attendance-monitoring",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@latest",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "BROWSERSLIST_IGNORE_OLD_DATA=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "eslint . && vitest --typecheck run && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:typecheck": "vitest --typecheck run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "lucide-vue-next": "^0.552.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.38.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^4.0.7",
    "vue-tsc": "^3.2.6"
  }
}
